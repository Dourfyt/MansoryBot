# Copy to .env and fill in. Never commit .env.

# --- Docker (docker compose up -d) ---
# Часовой пояс в контейнерах (по умолчанию в compose: Europe/Moscow). Не задавайте — будет MSK.
# TZ=Europe/Moscow
#
# В compose: PostgreSQL balenciaga_admin + пароль из compose, DATABASE_URL для бота/админки
# (пароль в URL — percent-encoded). BOT_BROADCAST_URL=http://bot:8765. Админка: 3000, бот HTTP: 8765.
# Сервис anon-child: как часто опрашивать БД на новые токены дочерних ботов (сек). По умолчанию 15.
# ANONYMOUS_CHILD_POLL_INTERVAL=15

# Единый токен бота (polling, планировщик, вызовы из CRM). Обязателен.
BOT_TOKEN=
# Отображаемое имя мастер-бота (как в Telegram) — для заголовков /инфо в комнатах без дочернего бота. Пусто → «Анонимный чат».
# BOT_DISPLAY_NAME=Balenciaga Support

# Устаревший алиас: если задан, используется только если BOT_TOKEN пуст (миграция со старых конфигов).
# GROUP_CONNECTOR_BOT_TOKEN=

# TronScan API
TRON_PRO_API_KEY=

# PostgreSQL (обязательно для бота и админки). Локально — тот же пользователь, что в compose;
# в пароле символы / + = в URL нужно кодировать (как ниже) или задать свой пароль в compose + .env.
DATABASE_URL=postgresql://balenciaga_admin:@localhost:5432/crm

# Telegram user IDs allowed as bot admins (comma-separated)
TELEGRAM_ADMIN_IDS=1234746517,7606256823

# Internal HTTP server on bot (broadcast from CRM)
BROADCAST_SERVER_HOST=127.0.0.1
BROADCAST_SERVER_PORT=8765
# Shared secret: CRM and bot must match; required for /broadcast on the bot
BROADCAST_INTERNAL_SECRET=

# CRM bootstrap (first admin user; disable after onboarding)
CRM_BOOTSTRAP_SECRET=
CRM_BOOTSTRAP_ADMIN_EMAIL=admin@local
CRM_BOOTSTRAP_ADMIN_PASSWORD=

# Session signing (32+ random bytes, base64 or hex)
CRM_SESSION_PEPPER=

# Лимиты ЛС в поддержку (бот): мин. секунд между сообщениями; макс. входящих в минуту на тикет
# SUPPORT_MIN_INTERVAL_SEC=4
# SUPPORT_MAX_MSG_PER_MINUTE=18
