[Unit]
Description=Group Connector Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt
Environment=PATH=/opt/.venv/bin
Environment=LANG=ru_RU.UTF-8
Environment=LC_ALL=ru_RU.UTF-8
Environment=LC_TIME=ru_RU.UTF-8
ExecStart=/opt/.venv/bin/python /opt/group_connector_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
